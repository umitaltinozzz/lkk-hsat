FROM debian@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY third_party/cadical /src/cadical
RUN cd /src/cadical && rm -rf build makefile && find . -type f \( -name '*.sh' -o -name '*.cpp' -o -name '*.hpp' -o -name '*.c' -o -name '*.h' -o -name '*.in' -o -name 'VERSION' -o -name 'configure' \) -exec sed -i 's/\r$//' {} + && sh configure -O3 --no-contracts --no-tracing && make -C build -j"$(nproc)" libcadical.a cadical

COPY native/core /src/core
COPY native/phase5/lkk_native5.cpp /src/lkk_native5.cpp
COPY native/phase4c/lkk_native4c.cpp /src/lkk_native4c.cpp
# The sealed Phase 4A source is compiled unchanged, and the core probe keeps the
# accepted registry, so the drift test can compare both against it.
COPY native/phase4a/lkk_native.cpp /src/lkk_native4a.cpp

RUN g++ -std=c++17 -O3 -DNDEBUG -Wall -Wextra -I/src/cadical/src -I/src/core /src/lkk_native5.cpp /src/cadical/build/libcadical.a -o /opt/lkk-native5
RUN g++ -std=c++17 -O3 -DNDEBUG -Wall -Wextra -I/src/cadical/src -I/src/core /src/lkk_native4c.cpp /src/cadical/build/libcadical.a -o /opt/lkk-native4c
RUN g++ -std=c++17 -O3 -DNDEBUG -Wall -Wextra -I/src/cadical/src -I/src/core /src/core/lkk_core_probe.cpp /src/cadical/build/libcadical.a -o /opt/lkk-core-probe
RUN g++ -std=c++17 -O3 -DNDEBUG -Wall -Wextra -I/src/cadical/src /src/lkk_native4a.cpp /src/cadical/build/libcadical.a -o /opt/lkk-native4a

FROM lkk-hsat-phase1:locked
COPY --from=builder /opt/lkk-native5 /opt/solvers/bin/lkk-native5
COPY --from=builder /opt/lkk-native4c /opt/solvers/bin/lkk-native4c
COPY --from=builder /opt/lkk-core-probe /opt/solvers/bin/lkk-core-probe
COPY --from=builder /opt/lkk-native4a /opt/solvers/bin/lkk-native4a
COPY --from=builder /src/cadical/build/cadical /opt/solvers/bin/cadical-api-build
